{
    "name": "andaniel05/flows",
    "type": "library",
    "description": "Step-by-step implementations",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Andaniel05\\Flows\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andy Navarro",
            "email": "andaniel05@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "pestphp/pest": "^4.6"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
